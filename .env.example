# LIFF app ID, e.g. 2000000000-abcdefgh (developers.line.biz > LIFF tab).
VITE_LIFF_ID=

# Leave empty when running behind the Caddy proxy (`make proxy`), which serves
# this app and the API on one origin — a relative /api path then works whatever
# URL the tunnel hands out today. Set an absolute URL only when the API really
# is on a different origin.
VITE_API_URL=
